# Copy to .env and adjust as needed. `docker compose up` reads this file
# automatically.

# --- Postgres (docs/adr/0010-single-postgres-schema-with-org-id.md) ---
POSTGRES_USER=darkfactory
POSTGRES_PASSWORD=darkfactory
POSTGRES_DB=darkfactory

# The restricted role `factory` and `worker` connect as
# (src/DarkFactory.Data/AppRole.cs). It owns nothing, so the REVOKEs in
# Migrations/0002_spec_graph.sql actually bind: the append-only spec tables
# are unwritable-after-insert to the running application, not merely
# never-written by it. Only the `migrate` service gets POSTGRES_USER's
# credentials, and it is what provisions this password.
APP_DB_PASSWORD=darkfactory_app

# --- Model access (docs/adr/0009-factory-owns-model-access.md) ---
# Required for the `factory` and `worker` services to run real stage
# agents. Local mode boots fine without it; runs just can't progress past
# intake until it's set.
ANTHROPIC_API_KEY=

# --- Tracing (docs/adr's OpenTelemetry note) ---
# Leave unset to keep traces console-only. Set to a collector endpoint
# (e.g. http://otel-collector:4317) to also export via OTLP.
OTEL_EXPORTER_OTLP_ENDPOINT=
