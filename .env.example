# Copy to .env and adjust as needed. `docker compose up` reads this file
# automatically.

# --- Postgres (docs/adr/0010-single-postgres-schema-with-org-id.md) ---
POSTGRES_USER=darkfactory
POSTGRES_PASSWORD=darkfactory
POSTGRES_DB=darkfactory

# The restricted role `factory` and `worker` connect as
# (src/DarkFactory.Data/AppRole.cs). It owns nothing, so the REVOKEs in
# Migrations/0002_spec_graph.sql actually bind: the append-only spec tables
# are unwritable-after-insert to the running application, not merely
# never-written by it. Only the `migrate` service gets POSTGRES_USER's
# credentials, and it is what provisions this password.
APP_DB_PASSWORD=darkfactory_app

# --- Artifact delivery (docs/adr/0004) ---
# Where a workspace server reaches this factory to fetch a patch. Inside
# Compose that is the service name; hosted, it is the public ingress. It
# cannot be derived from an inbound request, because the URL is minted for a
# different host to call.
ARTIFACTS_PUBLIC_BASE_URL=http://factory:8080
# HMAC key for signing those URLs. They carry customer code, and they are
# the only thing standing between a workspace server and the artifact store,
# so change this for anything that is not a local demo.
ARTIFACTS_SIGNING_KEY=local-dev-artifact-signing-key

# --- Model access (docs/adr/0027-foundry-model-gateway.md) ---
# All inference goes through IModelGateway, which has two implementations.
# Foundry is the production target; Anthropic-direct is the development
# provider. Leave both unset and the stack still boots — conversations then
# fail saying exactly that, rather than silently calling a model nobody
# chose.
#
# Anthropic | Foundry. Optional: with one provider configured it is
# inferred, and configuring both without saying which is an error rather
# than a coin toss.
MODEL_GATEWAY_PROVIDER=Anthropic

# The development provider.
ANTHROPIC_API_KEY=

# The production target. Managed identity in production (no key at all);
# a key only for local runs against Foundry.
Foundry__Endpoint=
Foundry__ApiKey=
Foundry__ResourceName=

# Role name -> Foundry deployment. Deployments are named after roles by
# convention, so these are only needed when they diverge.
# Foundry__Deployments__architect=architect
# Foundry__Deployments__planner=planner

# --- Tracing (docs/adr's OpenTelemetry note) ---
# Leave unset to keep traces console-only. Set to a collector endpoint
# (e.g. http://otel-collector:4317) to also export via OTLP.
OTEL_EXPORTER_OTLP_ENDPOINT=
