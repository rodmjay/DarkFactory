{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkfactory.dev/schemas/plan.schema.json",
  "title": "Plan",
  "description": "The artifact produced by the plan stage: an ordered set of concrete steps implement will carry out, derived from an approved Spec. See ADR-0004.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "spec_artifact_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the approved Spec this plan implements."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "target_paths": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Files or globs this step is expected to touch."
          }
        },
        "required": ["order", "description"]
      }
    },
    "test_strategy": {
      "type": "string",
      "minLength": 1,
      "description": "How the resulting change will be verified (which tests, what command)."
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["artifact_id", "run_id", "spec_artifact_ref", "steps", "test_strategy", "created_at"]
}
