@@ -0,0 +1,64 @@
+using System;
+using System.Data.Common;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging;
+
+namespace DarkFactory.Health.Services
+{
+    /// <summary>
+    /// Default implementation of <see cref="IDatabaseHealthCheckService"/> that attempts to
+    /// open a connection against the configured database.
+    /// </summary>
+    [Spec("01M1SBDTK1GZFHT7DPX1XZ8S09")]
+    public class DatabaseHealthCheckService : IDatabaseHealthCheckService
+    {
+        private static readonly TimeSpan ConnectionTimeout = TimeSpan.FromSeconds(5);
+
+        private readonly DbProviderFactory _dbProviderFactory;
+        private readonly string _connectionString;
+        private readonly ILogger<DatabaseHealthCheckService> _logger;
+
+        public DatabaseHealthCheckService(
+            DbProviderFactory dbProviderFactory,
+            IConfiguration configuration,
+            ILogger<DatabaseHealthCheckService> logger)
+        {
+            _dbProviderFactory = dbProviderFactory;
+            _connectionString = configuration.GetConnectionString("Default") ?? string.Empty;
+            _logger = logger;
+        }
+
+        public async Task<bool> IsDatabaseReachableAsync(CancellationToken cancellationToken)
+        {
+            if (string.IsNullOrEmpty(_connectionString))
+            {
+                _logger.LogWarning("No database connection string configured; reporting database as unreachable.");
+                return false;
+            }
+
+            using var timeoutCts = new CancellationTokenSource(ConnectionTimeout);
+            using var linkedCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, timeoutCts.Token);
+
+            try
+            {
+                using var connection = _dbProviderFactory.CreateConnection();
+                if (connection is null)
+                {
+                    _logger.LogWarning("Database provider factory returned a null connection; reporting database as unreachable.");
+                    return false;
+                }
+
+                connection.ConnectionString = _connectionString;
+                await connection.OpenAsync(linkedCts.Token);
+                return true;
+            }
+            catch (Exception ex)
+            {
+                _logger.LogWarning(ex, "Database health check failed.");
+                return false;
+            }
+        }
+    }
+}
