+using System.Data.Common;
+using DarkFactory.Health.Services;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace DarkFactory.Health
+{
+    /// <summary>
+    /// Registers the services needed to support the detailed health endpoint.
+    /// </summary>
+    [Spec("01M1SBDTK1GZFHT7DPX1XZ8S09")]
+    public static class HealthServiceCollectionExtensions
+    {
+        /// <summary>
+        /// Adds the database health check service used by GET /health/detailed.
+        /// </summary>
+        public static IServiceCollection AddDetailedHealthChecks(this IServiceCollection services, DbProviderFactory dbProviderFactory)
+        {
+            services.AddSingleton(dbProviderFactory);
+            services.AddScoped<IDatabaseHealthCheckService, DatabaseHealthCheckService>();
+            return services;
+        }
+    }
+}

