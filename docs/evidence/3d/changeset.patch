+using System.Threading;
+using System.Threading.Tasks;
+using DarkFactory.Health.Models;
+using DarkFactory.Health.Services;
+using Microsoft.AspNetCore.Mvc;
+
+namespace DarkFactory.Health.Controllers
+{
+    /// <summary>
+    /// Exposes health endpoints for the service.
+    /// </summary>
+    [ApiController]
+    [Route("health")]
+    public class HealthController : ControllerBase
+    {
+        private readonly IDatabaseHealthCheckService _databaseHealthCheckService;
+
+        public HealthController(IDatabaseHealthCheckService databaseHealthCheckService)
+        {
+            _databaseHealthCheckService = databaseHealthCheckService;
+        }
+
+        /// <summary>
+        /// Returns detailed health information, including whether the database is currently reachable.
+        /// </summary>
+        [HttpGet("detailed")]
+        [Spec("01M1SBDTK1GZFHT7DPX1XZ8S09")]
+        public async Task<ActionResult<DetailedHealthResponse>> GetDetailedHealth(CancellationToken cancellationToken)
+        {
+            var isDatabaseReachable = await _databaseHealthCheckService.IsDatabaseReachableAsync(cancellationToken);
+
+            var response = new DetailedHealthResponse
+            {
+                Status = isDatabaseReachable ? "healthy" : "degraded",
+                DatabaseReachable = isDatabaseReachable
+            };
+
+            return Ok(response);
+        }
+    }
+}
