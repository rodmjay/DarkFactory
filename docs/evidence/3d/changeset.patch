+using System.Threading;
+using System.Threading.Tasks;
+
+namespace DarkFactory.Health.Services
+{
+    /// <summary>
+    /// Checks whether the database backing this service is currently reachable.
+    /// </summary>
+    [Spec("01M1SBDTK1GZFHT7DPX1XZ8S09")]
+    public interface IDatabaseHealthCheckService
+    {
+        /// <summary>
+        /// Attempts to reach the database and reports success or failure.
+        /// </summary>
+        Task<bool> IsDatabaseReachableAsync(CancellationToken cancellationToken);
+    }
+}
diff --git a/src/Health/Services/DatabaseHealthCheckService.cs b/src/Health/Services/DatabaseHealthCheckService.cs
